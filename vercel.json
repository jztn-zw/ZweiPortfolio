    },
    {
      "source": "/experience/skills",
      "destination": "/experience/skills/index.html"
    },
    {
      "source": "/experience/projects",
      "destination": "/experience/projects/index.html"
    },
    {
      "source": "/experience/projects/web-mobile",
      "destination": "/experience/projects/web-mobile/index.html"
    },
    {
      "source": "/experience/projects/automation",
