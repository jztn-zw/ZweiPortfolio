{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/minimal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/minimal/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "src/{data/portfolio,lib/chatLanguage,lib/personalChat,lib/workInquiry}.ts"
    }
  },
  "rewrites": [
    {
      "source": "/experience/projects/everwell",
      "destination": "/experience/projects/everwell/index.html"
    },
    {
      "source": "/projects/everwell",
      "destination": "/projects/everwell/index.html"
    },
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/projects/web-mobile",
      "destination": "/projects/web-mobile/index.html"
    },
    {
      "source": "/projects/automation",
      "destination": "/projects/automation/index.html"
    },
    {
      "source": "/projects/tools",
      "destination": "/projects/tools/index.html"
    },
    {
      "source": "/projects/greenway",
      "destination": "/projects/greenway/index.html"
    },
    {
      "source": "/projects/vyora",
      "destination": "/projects/vyora/index.html"
    },
    {
      "source": "/experience/ask-ai",
      "destination": "/experience/ask-ai/index.html"
    },
    {
      "source": "/experience/numbers",
