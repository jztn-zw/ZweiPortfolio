{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "includeFiles": [
        "src/data/portfolio.ts",
        "src/lib/chatLanguage.ts",
        "src/lib/personalChat.ts",
        "src/lib/workInquiry.ts"
      ]
    }
  },
  "rewrites": [
    { "source": "/ask-ai", "destination": "/index.html" },
    { "source": "/numbers", "destination": "/index.html" },
    { "source": "/skills", "destination": "/index.html" },
    { "source": "/projects/greenway", "destination": "/index.html" }
  ]
}
