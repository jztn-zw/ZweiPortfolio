# Server-only settings for the Vercel visitor function. Never use a VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional stable random secret for signing visitor cookies.
VISITOR_COOKIE_SECRET=

# Server-only Ask AI settings. Keep both provider accounts on their Free tier.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b
# Optional stable secret for hashing rate-limit identities.
# Hosted AI requires the Upstash settings above; local dev uses memory otherwise.
AI_RATE_LIMIT_SECRET=

# Contact form delivery. Server-only, never use a VITE_ prefix.
RESEND_API_KEY=
# Sender address verified in Resend, e.g. Jaztin <contact@your-domain.com>.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=jaztinabramcontreras@gmail.com
# On Vercel, contact spam limits reuse the Upstash settings above.
